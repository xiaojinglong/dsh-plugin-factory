{
  "service": {
    "baseUrl": "http://127.0.0.1:8790",
    "token": "",
    "authHeader": "authorization",
    "authScheme": "Bearer",
    "headers": {},
    "timeoutMs": 30000
  },
  "polling": {
    "intervalMs": 3000,
    "timeoutMs": 600000
  },
  "endpoints": {
    "submit": {
      "method": "POST",
      "path": "/jobs"
    },
    "status": {
      "method": "GET",
      "path": "/jobs/{taskId}"
    },
    "result": {
      "method": "GET",
      "path": "/jobs/{taskId}/result"
    },
    "verifyQr": {
      "method": "GET",
      "path": "/jobs/{taskId}/verify"
    }
  },
  "submitBody": {
    "taskKey": "task",
    "paramsKey": ""
  },
  "statusMap": {
    "queued": "queued",
    "waiting_verify": "waiting_verify",
    "running": "running",
    "done": "succeeded",
    "failed": "failed"
  }
}