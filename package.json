{
  "name": "dsh-plugin-factory",
  "version": "3.25.2",
  "private": true,
  "description": "DSH Plugin Factory A: single-machine plugin factory. Business description -> runnable DSH plugin (service + MCP + skill + report).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node platform/factory/cli.cjs test",
    "doctor": "node platform/factory/cli.cjs doctor",
    "render": "node platform/factory/cli.cjs render",
    "check": "node scripts/check-syntax.mjs",
    "benchmark": "node benchmarks/run.cjs",
    "verify:clean": "node scripts/verify-clean-install.cjs",
    "catalog": "node scripts/plugin-catalog.cjs build",
    "plugin:info": "node scripts/plugin-package-info.cjs",
    "catalog:publish": "node scripts/catalog-publish.cjs",
    "catalog:serve": "node scripts/catalog-serve.cjs",
    "catalog:install": "node scripts/catalog-install.cjs",
    "record": "node scripts/desktop-record.cjs",
    "replay": "node scripts/desktop-replay.cjs",
    "setup": "node install.cjs",
    "start": "node scripts/start-factory.cjs",
    "stop": "node scripts/stop-factory.cjs",
    "autostart:install": "node scripts/install-autostart.cjs",
    "autostart:remove": "node scripts/uninstall-autostart.cjs",
    "install:check": "node apps/installer/installer.cjs check",
    "install:dry-run": "node apps/installer/installer.cjs install --dry-run",
    "control-plane": "node apps/control-plane/server.cjs",
    "control-plane:init": "node apps/control-plane/server.cjs --init",
    "control-plane:restore": "node apps/control-plane/restore.cjs",
    "health-check": "node scripts/health-check.cjs",
    "pilot-drill": "node scripts/pilot-drill.cjs",
    "ops:backup": "node scripts/ops-backup.cjs",
    "ops:backup-prune": "node scripts/ops-backup-prune.cjs",
    "ops:schedule": "node scripts/ops-schedule.cjs",
    "deps:check": "node scripts/deps-check.cjs",
    "factory-control-mcp": "node apps/factory-control-mcp/index.cjs",
    "generate:staging": "node apps/generator/generator.cjs staging",
    "pipeline": "node apps/generator/pipeline.cjs",
    "install:plugin": "node apps/installer/plugin-install.cjs",
    "release:package": "node scripts/package-release.cjs",
    "release:verify": "node scripts/verify-release.cjs",
    "release:install": "node scripts/install-from-release.cjs",
    "factory:health": "node scripts/factory-health.cjs",
    "factory:package": "node scripts/package-factory.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.6.1",
    "exceljs": "^4.4.0",
    "fastify": "5.12.8",
    "playwright": "1.65.0",
    "tar": "^7.5.23",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  }
}
